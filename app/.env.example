# ── Medplum (FHIR system of record, event source, audit trail) ─────────────
# Leave client id/secret blank to run against the built-in file-backed demo
# store (app/.data/fhir-store.json) — everything still works end to end.
MEDPLUM_BASE_URL=https://api.medplum.com/
MEDPLUM_CLIENT_ID=
MEDPLUM_CLIENT_SECRET=
# Shared secret used to sign/verify Subscription rest-hook payloads.
MEDPLUM_WEBHOOK_SECRET=change-me
# Public URL of this app (ngrok/cloudflared) used when creating Subscriptions.
WEBHOOK_BASE_URL=http://localhost:3000
# Base URL the demo CLI posts events to.
APP_URL=http://localhost:3000

# ── Moss (real-time semantic search: criteria, playbooks, LCD/NCD, SOPs) ───
# Leave blank to use the built-in lexical fallback index (same corpus).
# (MOSS_API_KEY is accepted as an alias for MOSS_PROJECT_KEY.)
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=

# ── LLM (reasoning step + copilot chat — only ever sees redacted text) ─────
# Leave both keys blank to use the deterministic template fallback.
# OpenRouter takes priority over direct Anthropic when both are set; models
# use OpenRouter's vendor-prefixed slugs (e.g. anthropic/claude-sonnet-4.5).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# Model for the dashboard copilot chat (defaults to OPENROUTER_MODEL).
OPENROUTER_CHAT_MODEL=
# Comma-separated slugs to override the copilot's model picker list.
OPENROUTER_MODELS=
# Direct Anthropic (used only when OPENROUTER_API_KEY is blank).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_EFFORT=low
# Model for the dashboard copilot chat (defaults to claude-opus-4-8).
ANTHROPIC_CHAT_MODEL=

# ── Stedi (EDI 270/271, 276/277, 837, 275) — blank = simulated acks ────────
STEDI_API_KEY=

# ── Deepgram (voice transcription + transcript redaction) ──────────────────
DEEPGRAM_API_KEY=
